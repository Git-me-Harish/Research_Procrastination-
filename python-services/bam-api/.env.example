# ============================================================
# BAM! API — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# All variable names MUST start with BAM_ (see config.py env_prefix).

#  Server 
BAM_HOST=0.0.0.0
BAM_PORT=8001

#  Security 
# CHANGE THIS in production (any long random string)
BAM_SECRET_KEY=bam-comic-secret-key-change-in-production-2026-very-long
BAM_ACCESS_TOKEN_EXPIRE_MINUTES=43200

#  Database 
# Default is SQLite at ./data/bam.db — leave empty to use default.
# For PostgreSQL: BAM_DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/bam
# BAM_DATABASE_URL=sqlite:///./data/bam.db

# ============================================================
# AI PROVIDER — choose ONE of the two configurations below
# ============================================================

#  OPTION A (RECOMMENDED): Groq 
# Why Groq? Fastest free-tier inference (~500 tokens/sec via LPU),
#           excellent at structured JSON, OpenAI-compatible API.
#
# 1. Sign up at https://console.groq.com
# 2. Go to "API Keys" → Create new key
# 3. Paste it below
#
# Available models (see https://console.groq.com/docs/models):
#   - llama-3.3-70b-versatile   (best overall, recommended)
#   - llama-3.1-8b-instant      (fastest, smaller)
#   - mixtral-8x7b-32768        (long context)
#   - gemma2-9b-it              (lightweight)

BAM_AI_PROVIDER=groq
BAM_AI_API_KEY=your_groq_api_key_here
BAM_AI_MODEL=llama-3.3-70b-versatile

#  OPTION B (ALTERNATIVE): Gemini 
# Why Gemini? Native JSON mode, 1500 RPD free tier, good reasoning.
#
# 1. Sign up at https://aistudio.google.com/app/apikey
# 2. Create API key
# 3. Uncomment the three lines below and comment out the Groq section above
#
# BAM_AI_PROVIDER=gemini
# BAM_AI_API_KEY=your_gemini_api_key_here
# BAM_AI_MODEL=gemini-1.5-flash
# (other options: gemini-1.5-pro, gemini-1.5-flash-8b, gemini-2.0-flash-exp)

#  Optional tuning 
# BAM_AI_TEMPERATURE=0.7
# BAM_AI_TIMEOUT_SECONDS=60.0
# BAM_AI_BASE_URL=   # leave empty to auto-resolve per provider
